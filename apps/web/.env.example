# Postgres connection string (e.g. from Neon: https://neon.tech).
# Optional: without it, orders placed in the shop still complete via WhatsApp,
# they just won't be saved for the admin dashboard to show.
DATABASE_URL=

# Yoco (https://www.yoco.com) card payments — Checkout API (hosted redirect).
# Secret key: from the Yoco Business Portal, used server-side only.
YOCO_SECRET_KEY=
# Not used by the current (Checkout API) integration — only needed if an
# inline card-tokenization flow is added later.
NEXT_PUBLIC_YOCO_PUBLIC_KEY=
# Registered via the API, not the Business Portal:
#   curl -X POST https://payments.yoco.com/api/webhooks \
#     -H "Authorization: Bearer $YOCO_SECRET_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"<name>","url":"https://<your-domain>/api/webhooks/yoco"}'
# The response's "secret" field (whsec_...) is this value.
YOCO_WEBHOOK_SECRET=
